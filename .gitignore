# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase — configs geradas pelo FlutterFire CLI (nunca hardcoded em
# código versionado, ver .claude/rules/security.md). Cada dev/CI gera a
# própria rodando `flutterfire configure`.
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Assinatura Android (nunca versionar chave/senha de release)
android/key.properties
*.jks
*.keystore

# Variáveis de ambiente / segredos locais
.env
.env.*
*.pem

# Drift/SQLite local (gerado em runtime, nunca versionado)
*.sqlite
*.sqlite-journal

# Windows/Linux desktop build runners (gerados, específicos da máquina)
windows/flutter/ephemeral/
linux/flutter/ephemeral/
macos/Flutter/ephemeral/
